{
  "manifest_version": 3,
  "name": "TencDoc → Obsidian",
  "short_name": "TencDoc2MD",
  "version": "0.6.3",
  "description": "一键将腾讯/企业微信文档导出并转成 Obsidian Markdown（配套 tencdoc-to-md）。",
  "permissions": [
    "downloads",
    "storage",
    "nativeMessaging",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://doc.weixin.qq.com/*",
    "https://docs.qq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://doc.weixin.qq.com/*",
        "https://docs.qq.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "TencDoc → Obsidian",
    "default_popup": "popup.html",
    "default_icon": {
      "19": "icons/icon19.png",
      "38": "icons/icon38.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
